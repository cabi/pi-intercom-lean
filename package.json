{
  "name": "pi-intercom-lean",
  "version": "0.1.0",
  "description": "Token-lean wrapper around pi-intercom: identical features, one merged tool with compact descriptions and schemas.",
  "license": "MIT",
  "type": "module",
  "main": "index.ts",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./node_modules/pi-intercom/skills"
    ]
  },
  "scripts": {
    "test": "tsx --test test/fill-ins.test.ts test/lean.test.ts",
    "measure": "tsx analysis/measure-tokens.ts"
  },
  "dependencies": {
    "pi-intercom": "0.17.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "typebox": "1.4.2",
    "tsx": "^4.20.0",
    "js-tiktoken": "^1.0.20"
  }
}
